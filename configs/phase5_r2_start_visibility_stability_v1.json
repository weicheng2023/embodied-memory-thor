{
  "policy_version": "phase5-r2-start-visibility-stability-v1",
  "trials_per_pose": 3,
  "pose_scope": "all normalized standing poses of the first standing-interactable pickupable Cup in sorted evaluator identity order",
  "pose_order": "deterministic pose_sort_key",
  "stable_rule": "3/3 fresh-reset trials pass all seven preconditions",
  "unstable_rule": "1/3 or 2/3 trials pass; pose excluded",
  "ineligible_rule": "0/3 trials pass; pose excluded",
  "no_stable_scene_classification": "scene_start_visibility_unstable_no_stable_pose",
  "allowed_actions": [
    "Reset",
    "GetInteractablePoses:selected Cup only",
    "TeleportFull:queried standing pose"
  ],
  "forbidden_actions": [
    "GetReachablePositions",
    "GetInteractablePoses:CoffeeMachine",
    "ToggleObjectOn",
    "PickupObject",
    "route construction or execution",
    "planner",
    "memory variant",
    "image or GUI"
  ],
  "required_preconditions": [
    "teleport_success",
    "cup_exists",
    "cup_pickupable",
    "cup_visible",
    "coffee_machine_exists",
    "coffee_machine_initially_off",
    "coffee_machine_initially_hidden"
  ],
  "public_output_policy": "counts, classifications and digests only; no coordinates or evaluator identity instances",
  "private_output_policy": "poses, evaluator identities and trial rows only under ignored outputs",
  "memory_agents_run": false,
  "images_saved": false,
  "formal_use_allowed": false
}
